#!/usr/bin/env bash
#
# Plantilla de credenciales de AWS para el laboratorio 03.
#
# Cómo usarla:
#   cp aws-credentials.sh.example aws-credentials.sh   # la copia queda ignorada por .gitignore
#   # editá aws-credentials.sh y reemplazá los valores <...>
#   source aws-credentials.sh                          # IMPORTANTE: con source, no con ./
#   aws sts get-caller-identity                        # verificá que las credenciales funcionan
#
# Al terminar el laboratorio:
#   unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
#
# Nunca subas aws-credentials.sh al repositorio.

# Si se ejecuta (./aws-credentials.sh o bash aws-credentials.sh) en lugar de usar source,
# las variables no quedan cargadas en tu terminal: abortamos con un aviso.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "Este archivo no se ejecuta. Usá: source aws-credentials.sh" >&2
  exit 1
fi

export AWS_ACCESS_KEY_ID="<TU_ACCESS_KEY_ID>"
export AWS_SECRET_ACCESS_KEY="<TU_SECRET_ACCESS_KEY>"

# Solo para credenciales temporales (las que empiezan con ASIA..., por ejemplo las de un
# sandbox, SSO o AssumeRole): completá también el token de sesión.
# Si usás credenciales permanentes de un usuario IAM (AKIA...), dejá esta línea comentada.
# export AWS_SESSION_TOKEN="<TU_SESSION_TOKEN>"

# Usá la misma región que aws_region en terraform.tfvars.
export AWS_REGION="us-east-1"
export AWS_DEFAULT_REGION="us-east-1"

echo "Credenciales de AWS cargadas (región: ${AWS_REGION}). Verificá con: aws sts get-caller-identity"
